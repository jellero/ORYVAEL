{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oryvael.dev/spec/architecture.schema.json",
  "title": "ORYVAEL Architecture",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "components"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layer"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "layer": {
            "enum": ["kernel", "trusted_core", "system_service", "ai_control", "application"]
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true,
            "default": []
          },
          "allowed_dependencies": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "forbidden_dependencies": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true,
            "default": []
          },
          "capabilities_required": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true,
            "default": []
          },
          "capabilities_exposed": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true,
            "default": []
          }
        }
      }
    }
  }
}
