{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oryvael.dev/spec/control-signature.schema.json",
  "title": "ORYVAEL Control Artifact Signature",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "signer_id", "key_version", "artifact_sha256", "signature_hex"],
  "properties": {
    "version": {"const": 1},
    "kind": {
      "enum": ["tool_catalog", "change_plan", "principal_policy", "workspace_registry", "peer_policy"]
    },
    "signer_id": {"type": "string", "minLength": 1},
    "key_version": {"type": "integer", "minimum": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "signature_hex": {"type": "string", "pattern": "^[0-9a-fA-F]{128}$"}
  }
}
