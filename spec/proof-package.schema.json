{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oryvael.dev/spec/proof-package.schema.json",
  "title": "ORYVAEL Proof Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id",
    "change_class",
    "change_plan_sha256",
    "evidence_verified",
    "source",
    "verifiers",
    "artifacts",
    "eligible",
    "eligibility_reasons",
    "build"
  ],
  "properties": {
    "change_id": {
      "type": "string"
    },
    "change_class": {
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3",
        "C4"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "tree": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "verifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "principal",
          "status",
          "evidence_hash",
          "operation_id"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "principal": {
            "type": "string"
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "test",
              "security",
              "reviewer",
              null
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skipped"
            ]
          },
          "evidence_hash": {
            "type": "string"
          },
          "operation_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "eligible": {
      "type": "boolean"
    },
    "human_approvals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eligibility_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "change_plan_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "evidence_verified": {
      "type": "boolean"
    },
    "build": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "sbom_sha256",
        "cargo_lock_sha256",
        "reproducible",
        "independent_builder",
        "reproducible_manifest_sha256"
      ],
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "sbom_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "cargo_lock_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "reproducible": {
          "type": "boolean"
        },
        "independent_builder": {
          "type": [
            "string",
            "null"
          ]
        },
        "reproducible_manifest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    }
  }
}
