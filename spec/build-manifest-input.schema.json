{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oryvael.dev/spec/build-manifest-input.schema.json",
  "title": "ORYVAEL Build Manifest Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id",
    "builder_principal",
    "source",
    "toolchain",
    "target",
    "profile",
    "build_command",
    "cargo_lock",
    "cargo_metadata",
    "artifacts"
  ],
  "properties": {
    "change_id": {"type": "string", "minLength": 1},
    "builder_principal": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1},
        "tree": {"type": ["string", "null"]}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "target": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "build_command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "cargo_lock": {"type": "string", "minLength": 1},
    "cargo_metadata": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
