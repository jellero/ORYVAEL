{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oryvael.dev/spec/root-trust-policy.schema.json",
  "title": "ORYVAEL Root Trust Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "epoch", "signers"],
  "properties": {
    "version": {"const": 1},
    "epoch": {"type": "integer", "minimum": 1},
    "signers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "key_version", "public_key_hex", "status", "allowed_kinds"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "key_version": {"type": "integer", "minimum": 1},
          "public_key_hex": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "status": {"enum": ["active", "revoked"]},
          "allowed_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["tool_catalog", "change_plan", "principal_policy", "workspace_registry", "peer_policy"]
            }
          }
        }
      }
    }
  }
}
