{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oryvael.dev/spec/tool-invocation.schema.json",
  "title": "ORYVAEL Tool Invocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["principal","role","change_id","change_plan","workspace","tool","action","audit_log","artifact_store"],
  "properties": {
    "principal": {"type": "string", "minLength": 1},
    "role": {"enum": ["developer", "test", "security", "reviewer"]},
    "change_id": {"type": "string", "minLength": 1},
    "change_plan": {"type": "string", "minLength": 1},
    "workspace": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "audit_log": {"type": "string", "minLength": 1},
    "artifact_store": {"type": "string", "minLength": 1}
  }
}
