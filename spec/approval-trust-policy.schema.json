{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oryvael.dev/spec/approval-trust-policy.schema.json",
  "title": "ORYVAEL Human Approval Root Trust",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "thresholds", "signers"],
  "properties": {
    "version": {"const": 1},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c3", "c4"],
      "properties": {
        "c3": {"type": "integer", "minimum": 1},
        "c4": {"type": "integer", "minimum": 1}
      }
    },
    "signers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "public_key_hex", "allowed_classes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "public_key_hex": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "allowed_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["C3", "C4"]}
          }
        }
      }
    }
  }
}
