{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oryvael.dev/spec/supervisor-job.schema.json",
  "title": "ORYVAEL Local Supervisor Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "principal",
    "change_id",
    "workspace",
    "command",
    "network",
    "read_only_paths",
    "timeout_seconds",
    "limits",
    "audit_log",
    "artifact_store"
  ],
  "properties": {
    "principal": {
      "type": "string",
      "minLength": 1
    },
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "network": {
      "enum": ["deny", "host"]
    },
    "read_only_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_bytes": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "cpu_seconds": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "file_size_bytes": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "audit_log": {
      "type": "string",
      "minLength": 1
    },
    "artifact_store": {
      "type": "string",
      "minLength": 1
    }
  }
}
