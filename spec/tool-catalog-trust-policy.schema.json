{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oryvael.dev/spec/tool-catalog-trust-policy.schema.json",
  "title": "ORYVAEL Tool Catalog Trust Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "signers"],
  "properties": {
    "version": {"const": 1},
    "signers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "public_key_hex"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "public_key_hex": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    }
  }
}
