{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oryvael.dev/spec/peer-policy.schema.json",
  "title": "ORYVAEL Local Peer Authorization Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "bindings"],
  "properties": {
    "version": {"const": 1},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "uid", "gid", "executable_sha256", "operations", "principals"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "uid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "gid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["status", "verify", "supervise"]}
          },
          "principals": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
